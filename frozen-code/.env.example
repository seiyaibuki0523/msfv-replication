# ============================================================
# MSFV frozen pipeline — environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.
#
# This file is the pipeline-only subset of the production .env.example:
# the deployment configuration of the commercial product that this
# code was frozen from (billing, web hosting, mail, storage, CI/CD
# integrations) has been removed because it is irrelevant to the paper.
# ============================================================

# ------------------------------------------------------------
# LLM backends. The experiments reported in the paper ran every model
# through OpenRouter (see frozen-code/src/main/core/ai_engine/local_llm.py,
# _OPENROUTER_ALIASES):
#   openrouter:qwen3-coder   -> qwen/qwen3-coder-next
#   openrouter:gemma-4-31b   -> google/gemma-4-31b-it
#   openrouter:nemotron-120b -> nvidia/nemotron-3-super-120b-a12b
# ------------------------------------------------------------
OPENROUTER_API_KEY=""

# Anthropic / NVIDIA NIM / Gemini / OpenAI keys are only needed if a chain
# below names one of those backends (the paper's chains do not).
ANTHROPIC_API_KEY=""
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"
GEMINI_API_KEY=""
PROJECT_ID=""
OPENAI_API_KEY=""

# Default backend when no per-layer chain is given: claude | nvidia | gemini | openai | mixed
DEFAULT_LLM_BACKEND="mixed"

# ------------------------------------------------------------
# Self-hosted vLLM endpoints (optional; the earliest development runs used
# three private vLLM hosts, the published runs used OpenRouter). Server-reported
# model ids are mapped in core/ai_engine/local_llm.py::_VLLM_ALIASES.
# ------------------------------------------------------------
VLLM_URL="http://<nemotron-host>:8000/v1"        # NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
VLLM_GEMMA_URL="http://<gemma-host>:8000/v1"     # gemma-4-31B-it
VLLM_QWEN_URL="http://<qwen-host>:8000/v1"       # Qwen3-Coder-Next-AWQ-4bit

# ------------------------------------------------------------
# Workspace — where runtime outputs go (reports, PoC, logs, scan state).
# Default: /tmp/aisec. The experiment runners set this themselves.
# ------------------------------------------------------------
# AISEC_WORKSPACE="/tmp/aisec"

# ------------------------------------------------------------
# Optional in-process pattern/finding cache sidecar (loopback only).
# Leave VAULT_API_TOKEN empty to disable.
# ------------------------------------------------------------
VAULT_API_URL="http://127.0.0.1:8765"
VAULT_API_TOKEN=""
VAULT_API_TIMEOUT="20.0"

# ============================================================
# Per-layer backend chains. Each accepts a comma-separated chain; the
# first link is the primary, the rest are fallbacks on transient errors
# or DSPy parse failures. Prefixes: openrouter:<alias> | vllm:<alias> |
# opus | sonnet (Anthropic) | nvidia:<model>.
#
# The experiment runners (experiments/run_ablation_fast.py and the
# round drivers) OVERRIDE these with AISEC_FAST_CHAIN and
# AISEC_VERIFY_BACKEND_OVERRIDE; the values below are only defaults for
# interactive use of the pipeline.
# ============================================================
AISEC_LOCAL_FILTER_MODEL="openrouter:qwen3-coder,openrouter:nemotron-120b"
AISEC_CLUSTER_MODEL=""    # defaults to AISEC_LOCAL_FILTER_MODEL
AISEC_ANALYSE_CRITICAL_BACKEND="openrouter:qwen3-coder,openrouter:nemotron-120b"
AISEC_ANALYSE_HIGH_BACKEND="openrouter:qwen3-coder,openrouter:nemotron-120b"
AISEC_QUERY_BACKEND="openrouter:qwen3-coder,openrouter:nemotron-120b"
AISEC_VERIFY_BACKEND="openrouter:nemotron-120b"
AISEC_POC_GEN_BACKEND="openrouter:qwen3-coder,openrouter:nemotron-120b"
AISEC_POC_VERIFY_BACKEND="openrouter:nemotron-120b"
AISEC_PATCH_BACKEND="openrouter:qwen3-coder,openrouter:nemotron-120b"
AISEC_REGRESSION_BACKEND="openrouter:nemotron-120b"
AISEC_IAC_BACKEND="openrouter:nemotron-120b"
AISEC_SUMMARY_MODEL="openrouter:nemotron-120b"
AISEC_ROUTER_BACKEND="openrouter:qwen3-coder"

# Parallelism for Layer 4/5/5.5 ThreadPoolExecutor (1-16, default 3).
AISEC_PARALLEL_OPUS=3
# Batched Layer 3 (opt-in; off in every published run)
AISEC_CLUSTER_MODE=0

# Layer 4.5 multi-language PoC sandbox (non-Solidity PoCs; Solidity PoCs use host forge)
AISEC_POC_SANDBOX_IMAGE=cevanex/poc-sandbox:1
AISEC_POC_NO_EXEC=0

# ============================================================
# Experiment knobs used by the paper (all read by the frozen code;
# see CODE_VERSIONS.md for which runs set which values)
# ============================================================
# Detection chain for L3/L4/L5/PoC-generation, e.g.
#   "openrouter:qwen3-coder,openrouter:nemotron-120b"   (qwen arm, Nemotron fallback)
#   "openrouter:gemma-4-31b,openrouter:nemotron-120b"   (gemma arm)
#   "openrouter:nemotron-120b"                          (Nemotron arm)
# AISEC_FAST_CHAIN=""
# Verification model for Layer 5.5 (overrides AISEC_VERIFY_BACKEND)
# AISEC_VERIFY_BACKEND_OVERRIDE="openrouter:nemotron-120b"
# Signals admitted to the verifier: comma list of identity,source,concern,poc
# AISEC_VERIFY_SIGNALS="identity,source,concern,poc"
# "naive" selects the single-prompt RQ4 control instead of the structured prompt
# AISEC_VERIFY_MODE=""
# 1 disables Layer 5.5 entirely (the no-verification baseline)
# AISEC_DISABLE_VERIFY=0
# 1 disables PoC execution (verdict withheld everywhere)
# AISEC_DISABLE_POC_VALIDATOR=0
# Seed passed to the serving API (OpenRouter providers did not honour it)
# AISEC_LLM_SEED=1
# Force a sampling temperature (Nemotron detection re-run used 0)
# AISEC_LLM_TEMPERATURE=""
# Output budget (Nemotron detection re-run used 12000; verification uses the
# per-model default: 2048 qwen/gemma, 16000 Nemotron)
# AISEC_LLM_MAX_TOKENS=""
# "off" prepends "detailed thinking off" for Nemotron (detection re-run only)
# AISEC_NEMOTRON_THINKING=""
# Pin one OpenRouter upstream provider (Nemotron runs used "DeepInfra")
# AISEC_OPENROUTER_PROVIDER=""
# Continue past non-fatal layer errors
# AISEC_TOLERANT_LAYER_ERRORS=0
# Per-call timeout / retries used by the runners
# AISEC_LLM_TIMEOUT=240
# AISEC_LLM_RETRIES=4
# Disable the result cache between runs (every published run set 0)
# AISEC_RESULT_CACHE=0
