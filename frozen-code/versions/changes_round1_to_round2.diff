+def _naive_match(self, file_rel: str, func_name: str):
+    """The Layer-4 finding matching (file, function) — same fuzzy match as
+    _render_poc_signal, reused by naive_verify for line + raw PoC outcome."""
+    for r in self.state.opus_results:
+        if r.get("layer") != 4:
+            continue
+        f = r.get("finding", {})
+        if f.get("file") != file_rel:
+            continue
+        if (func_name in str(f.get("message", ""))
+                or func_name in str(r.get("analysis", ""))):
+            return r
+    return None
